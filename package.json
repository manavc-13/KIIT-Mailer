{
  "name": "kiit-mailer",
  "version": "2.0.0",
  "private": true,
  "description": "KIIT Mailer: login-walled, multi-account institutional mailing utility (Vite + React SPA, Hono API on Vercel, Neon Postgres)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file=.env server/dev.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-vercel.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "create-admin": "tsx --env-file=.env scripts/create-admin.ts",
    "build:web": "vite build"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@hono/node-server": "^2.1.11",
    "@neondatabase/serverless": "^1.2.1",
    "@tanstack/react-query": "^5.108.4",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-subscript": "^3.35.0",
    "@tiptap/extension-superscript": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-text-style": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@uiw/react-codemirror": "^4.25.13",
    "@vercel/blob": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "dompurify": "^3.5.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.23",
    "html-to-text": "^10.0.1",
    "js-beautify": "^2.0.3",
    "juice": "^12.2.6",
    "lucide-react": "^1.82.0",
    "nodemailer": "^10.6.1",
    "papaparse": "^5.7.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/dompurify": "^3.0.5",
    "@types/html-to-text": "^9.0.4",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^26.6.11",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vercel/node": "^33.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
