# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Neon Postgres connection string (use the pooled "-pooler" host).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/kiit_mailer?sslmode=require

# 32 random bytes, base64. Encrypts Google App Passwords at rest and signs unsubscribe links.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER change it once sender accounts exist (they would have to be re-entered).
APP_ENCRYPTION_KEY=

# Public base URL of the app (used in one-click unsubscribe links).
APP_BASE_URL=http://localhost:5173

# Vercel Blob store for ATTACHMENTS (private store). Required when deployed on Vercel.
BLOB_READ_WRITE_TOKEN=

# Optional: a second, PUBLIC Vercel Blob store for images inside email bodies.
# Without it, body images are embedded as inline (CID) attachments at send time.
BLOB_PUBLIC_READ_WRITE_TOKEN=

# Optional: pacing between messages within a send (milliseconds). Defaults 1500-3000.
# SEND_DELAY_MIN_MS=1500
# SEND_DELAY_MAX_MS=3000
